# Application settings
APP_NAME="NER Landslide AI"
APP_ENV="development"
PROJECT_ROOT="/workspace/NER-Landslide-AI"
LOG_LEVEL="INFO"

# Data settings
DATA_DIR="./data"
RAW_DATA_DIR="./data/raw"
PROCESSED_DATA_DIR="./data/processed"
TRAINING_DATA_DIR="./data/training"

# Postgres / PostGIS
POSTGRES_DB="ner_landslide"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/ner_landslide"

# GIS / CRS
DEFAULT_CRS="EPSG:4326"
TARGET_CRS="EPSG:32646"

# API
API_HOST="0.0.0.0"
API_PORT="8000"

# Frontend
FRONTEND_PORT="5173"

# Data source placeholders
GOV_DATA_SOURCE_URL=""
EARTHDATA_USERNAME=""
EARTHDATA_PASSWORD=""
OPENROUTER_API_KEY=""

# LLM (optional future use)
LLM_MODEL=""
LLM_API_KEY=""
